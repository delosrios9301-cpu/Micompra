rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function accessDoc(uid) {
      return get(/databases/$(database)/documents/workspaceAccess/$(uid));
    }
    function isWorkspaceMember(workspaceId) {
      return signedIn()
        && accessDoc(request.auth.uid).data.workspaceId == workspaceId;
    }
    function isWorkspaceOwner(workspaceId) {
      return signedIn()
        && get(/databases/$(database)/documents/userWorkspaces/$(workspaceId)).data.ownerUid == request.auth.uid;
    }
    match /workspaceAccess/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && (
        (request.auth.uid == userId && request.resource.data.ownerUid == userId && request.resource.data.workspaceId == userId)
        || (request.resource.data.ownerUid == request.auth.uid && request.resource.data.workspaceId == request.auth.uid)
      );
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.workspaceId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid && userId != request.auth.uid;
    }
    match /userWorkspaces/{workspaceId} {
      allow read: if signedIn() && (request.auth.uid == workspaceId || isWorkspaceMember(workspaceId));
      allow create: if signedIn() && request.auth.uid == workspaceId
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isWorkspaceMember(workspaceId);
      allow delete: if isWorkspaceOwner(workspaceId);
    }
  }
}