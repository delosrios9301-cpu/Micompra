rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPrimaryOwner() {
      return signedIn() && request.auth.token.email == 'delosrios9301@gmail.com';
    }
    function accessDoc(uid) {
      return get(/databases/$(database)/documents/workspaceAccess/$(uid));
    }
    function isWorkspaceMember(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaceAccess/$(request.auth.uid))
        && accessDoc(request.auth.uid).data.workspaceId == workspaceId;
    }
    function isWorkspaceOwner(workspaceId) {
      return signedIn()
        && get(/databases/$(database)/documents/userWorkspaces/$(workspaceId)).data.ownerUid == request.auth.uid;
    }
    function isEmptyWorkspaceReset() {
      return request.resource.data.workspace is map
        && resource.data.workspace is map
        && (resource.data.workspace.products.size() > 0
          || resource.data.workspace.stores.size() > 0
          || resource.data.workspace.lists.size() > 0
          || resource.data.workspace.purchases.size() > 0
          || resource.data.workspace.inventory.size() > 0
          || resource.data.workspace.movements.size() > 0
          || resource.data.workspace.expenses.size() > 0
          || resource.data.workspace.budgets.size() > 0
          || resource.data.workspace.activity.size() > 0)
        && request.resource.data.workspace.products.size() == 0
        && request.resource.data.workspace.stores.size() == 0
        && request.resource.data.workspace.lists.size() == 0
        && request.resource.data.workspace.purchases.size() == 0
        && request.resource.data.workspace.inventory.size() == 0
        && request.resource.data.workspace.movements.size() == 0
        && request.resource.data.workspace.expenses.size() == 0
        && request.resource.data.workspace.budgets.size() == 0
        && request.resource.data.workspace.activity.size() == 0;
    }

    match /workspaceAccess/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId || isWorkspaceOwner(resource.data.workspaceId)
      );
      allow create: if signedIn() && (
        (request.auth.uid == userId
          && isPrimaryOwner()
          && request.resource.data.ownerUid == userId
          && request.resource.data.workspaceId == userId
          && request.resource.data.role == 'owner')
        || (userId != request.auth.uid
          && request.resource.data.role == 'member'
          && isWorkspaceOwner(request.resource.data.workspaceId)
          && request.resource.data.ownerUid == request.auth.uid)
      );
      allow update: if signedIn() && (
        (isWorkspaceOwner(resource.data.workspaceId)
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.ownerUid == request.auth.uid)
        || (isPrimaryOwner() && userId == request.auth.uid
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.role == 'owner')
      );
      allow delete: if isWorkspaceOwner(resource.data.workspaceId) && userId != request.auth.uid;
    }

    match /revokedUsers/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId || isWorkspaceOwner(resource.data.workspaceId)
      );
      allow create, update: if signedIn()
        && request.resource.data.uid == userId
        && isWorkspaceOwner(request.resource.data.workspaceId);
      allow delete: if isWorkspaceOwner(resource.data.workspaceId);
    }

    match /userWorkspaces/{workspaceId}/clientDevices/{deviceId} {
      allow read: if isWorkspaceOwner(workspaceId)
        || (isWorkspaceMember(workspaceId) && resource.data.uid == request.auth.uid);
      allow create: if isWorkspaceMember(workspaceId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.appVersion == '2.1.0-compat'
        && request.resource.data.keys().hasOnly(['uid', 'appVersion', 'userAgent', 'firstSeenAt', 'lastSeenAt']);
      allow update: if isWorkspaceMember(workspaceId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.appVersion == '2.1.0-compat'
        && request.resource.data.keys().hasOnly(['uid', 'appVersion', 'userAgent', 'firstSeenAt', 'lastSeenAt']);
      allow delete: if isWorkspaceOwner(workspaceId);
    }

    match /userWorkspaces/{workspaceId}/records/{recordId} {
      allow read, create, update: if isWorkspaceOwner(workspaceId);
      allow delete: if false;
    }

    match /userWorkspaces/{workspaceId}/migrations/{migrationId} {
      allow read, create, update: if isWorkspaceOwner(workspaceId);
      allow delete: if false;
    }

    match /userWorkspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId)
        || (signedIn() && request.auth.uid == workspaceId);
      allow create: if signedIn() && (
        (request.auth.uid == workspaceId && request.resource.data.ownerUid == request.auth.uid)
        || (isPrimaryOwner() && request.resource.data.ownerUid == request.auth.uid)
      );
      allow update: if isWorkspaceMember(workspaceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.uid == resource.data.uid
        && (!isEmptyWorkspaceReset() || isWorkspaceOwner(workspaceId));
      allow delete: if isWorkspaceOwner(workspaceId);
    }
  }
}